# Keep text sources, configs, docs and text fixtures LF across platforms.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.vtt text eol=lf
*.csv text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
bun.lock text eol=lf

# Binary media fixtures must never be line-ending normalized.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.mkv binary
